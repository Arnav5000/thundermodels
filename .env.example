# Keep the model on Render persistent disk so redeploys do not download it again.
MODEL_DIR=/var/data/models
MODEL_REPO_ID=bartowski/Llama-3.2-1B-Instruct-GGUF
MODEL_FILENAME=Llama-3.2-1B-Instruct-Q4_K_M.gguf
MODEL_REVISION=main
MODEL_DOWNLOAD_ON_START=true
MODEL_CONTEXT_SIZE=1024
MODEL_THREADS=2
MODEL_MAX_TOKENS=128

# Set this in Render and configure the same value in ThunderAI-CRM.
MODEL_API_KEY=replace-with-a-long-random-value
